{
  "name": "mindcrafti-worksheet-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate": "node generate.mjs",
    "html": "node generate.mjs --html-only",
    "test:math": "node mathjax-smoke.mjs",
    "test:layout": "node --test layout.test.mjs",
    "test:plain": "node --test plain.test.mjs",
    "test": "node mathjax-smoke.mjs && node diagrams.test.mjs && node --test visual-tasks.test.mjs layout.test.mjs plain.test.mjs pagination.test.mjs",
    "test:pagination": "node --test pagination.test.mjs"
  },
  "dependencies": {
    "mathjax": "^4.1.3"
  }
}
