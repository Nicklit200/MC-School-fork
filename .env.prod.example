# Copy to .env (same folder as docker-compose.prod.yml) and fill in real values.
# NEVER commit the real .env.

# Database (internal to the compose network; still choose a strong password).
DB_NAME=flashcard
DB_USERNAME=flashcard
DB_PASSWORD=replace_with_a_strong_password

# JWT signing key — must be at least 32 characters and secret.
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRATION_MINUTES=1440

# Public URL where the app is reached (used for CORS and email links).
# For a local trial use http://localhost; in production use your https domain.
PUBLIC_BASE_URL=http://localhost
HTTP_PORT=80

# First admin account, created once on first startup.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password
ADMIN_NAME=Administrator

# Email (optional). Set MAIL_ENABLED=true and fill SMTP details to send real
# invitation and reminder emails; otherwise they are only logged.
MAIL_ENABLED=false
MAIL_FROM=no-reply@example.com
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
REVIEW_REMINDERS_ENABLED=false

# --- Online classes (LiveKit) -------------------------------------------------
# Master switch. With false, the existing Google Meet / Soniox lesson flow is
# unchanged and no online-class endpoint is reachable.
ONLINE_CLASSES_ENABLED=false
# LiveKit Cloud project URL and server credentials. The browser only ever
# receives the wss:// URL and a short-lived scoped token — never the secret.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace-me
LIVEKIT_API_SECRET=replace-me
# Origins the browser may open a signalling connection to. Must match LIVEKIT_URL.
# Leave empty when the feature is off so the CSP stays maximally strict.
LIVEKIT_CSP_ORIGINS=wss://your-project.livekit.cloud https://your-project.livekit.cloud

# --- Recording (optional) -----------------------------------------------------
LIVEKIT_RECORDING_ENABLED=false
# S3-compatible storage: AWS S3, Cloudflare R2 or MinIO.
CLASS_ARTIFACT_STORAGE_ENDPOINT=
CLASS_ARTIFACT_STORAGE_REGION=auto
CLASS_ARTIFACT_STORAGE_BUCKET=
CLASS_ARTIFACT_STORAGE_ACCESS_KEY=replace-me
CLASS_ARTIFACT_STORAGE_SECRET_KEY=replace-me
# R2 and MinIO need path-style addressing; AWS S3 does not.
CLASS_ARTIFACT_STORAGE_PATH_STYLE=true
CLASS_RECORDING_RETENTION_DAYS=90
CLASS_TRANSCRIPT_RETENTION_DAYS=365

# --- Transcription (optional) -------------------------------------------------
ONLINE_CLASS_TRANSCRIPTION_ENABLED=false
ONLINE_CLASS_TRANSCRIPTION_AGENT=mc-transcriber
# Shared secret between the backend and the transcription worker. Generate with
# `openssl rand -hex 32`. Not an end-user credential and never sent to a browser.
TRANSCRIPTION_INTERNAL_TOKEN=replace-me
# STT credential. Consumed ONLY by services/transcription-agent — the backend
# never receives it.
SONIOX_API_KEY=replace-me
TRANSCRIPTION_LANGUAGES=ru,de
