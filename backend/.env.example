# Copy to .env (never commit .env) or export these variables before starting the app.
# All values below are placeholders — the application also has local-dev defaults
# that match compose.yaml, so for plain local development nothing is required.

DB_HOST=localhost
DB_PORT=5434
DB_NAME=mydb
DB_USERNAME=myuser
DB_PASSWORD=replace_me

# Minimum 32 characters. Required in production.
JWT_SECRET=replace_with_a_random_string_of_at_least_32_chars
JWT_EXPIRATION_MINUTES=1440

# Comma-separated browser origins allowed by CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Set these once to create the first admin account on startup.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_me
ADMIN_NAME=Administrator

# Base URL of the deployed web app (used in invitation/reminder email links).
FRONTEND_BASE_URL=http://localhost:5173

# Transactional email. Leave MAIL_ENABLED=false to log emails instead of sending.
# To send real email, set MAIL_ENABLED=true and fill in your SMTP provider
# (SendGrid, Mailgun, Gmail, Mailtrap, ...).
MAIL_ENABLED=false
MAIL_FROM=no-reply@example.com
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# Daily spaced-repetition review reminders. Off by default.
REVIEW_REMINDERS_ENABLED=false
REVIEW_REMINDERS_CRON=0 0 8 * * *

# Shared Meta funnel outbox. Keep disabled until this change is reviewed/deployed.
# A token alone never enables sends. No token or payload is written to server logs.
META_CAPI_ACCESS_TOKEN=
META_CAPI_SENDING_ENABLED=false
META_CAPI_PIXEL_ID=1391828005920802
META_CAPI_GRAPH_VERSION=v26.0
# Copy the code from Events Manager -> Test Events into the TEST environment only.
# The code is captured when an event is recorded; existing TEST_SENT events are
# never replayed as live events after this value is removed. Use a new test lead.
META_CAPI_TEST_EVENT_CODE=
# Enqueue after successful database writes, deliver outside the lead request.
# Failed attempts retry after 5 minutes with the same event_id/event_time.
META_CAPI_WORKER_DELAY_MS=15000

# Direct ChatGPT PDF parameters. Exact HTTPS runtime hostnames only, comma separated.
# No wildcards, IP addresses or arbitrary cloud-storage suffixes are accepted.
# Add an observed runtime hostname only after verifying it is an official file host.
# Downloads use no account credentials; the signed URL itself authorizes retrieval.
# MCP direct upload remains limited to 15 MiB per PDF, with PDF content validation.
MINDCRAFTI_CHATGPT_FILE_HOSTS=files.oaiusercontent.com
