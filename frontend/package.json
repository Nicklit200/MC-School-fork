{
  "name": "mc-school-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Web client for the Mindcraft School flashcard app (teacher desktop + student mobile)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev:pen-lab": "vite --config vite.config.ts --host 0.0.0.0 --port 5173 --open /pen-lab.html"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "@livekit/components-react": "2.9.24",
    "@livekit/components-styles": "1.2.0",
    "konva": "10.5.0",
    "livekit-client": "2.22.3",
    "pdfjs-dist": "4.10.38",
    "react-konva": "18.2.16",
    "perfect-freehand": "1.2.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "22.19.2",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^25.0.1",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
